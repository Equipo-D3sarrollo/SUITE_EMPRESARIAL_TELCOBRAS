# Configuración local de Claude Code (hooks con rutas de cada equipo)
.claude/settings.local.json

# Grafo de graphify (se regenera)
graphify-out/

# Código de terceros clonado como referencia (APIDIAN, MIT, 32 MB de PHP): no se versiona en la suite
docs/modules/documents/apidian/repositorio-original/*
!docs/modules/documents/apidian/repositorio-original/README.md
!docs/modules/documents/apidian/repositorio-original/clonar-apidian.ps1

# Dependencias y builds
node_modules/
dist/
.env
# Ajustes locales de Compose de cada equipo (el puerto se cambia con POSTGRES_PORT en .env)
infra/compose/docker-compose.override.yml
.env.*
!.env.example

# Resultados de pruebas, cobertura y auditorías
coverage/
playwright-report/
test-results/
.lighthouseci/

# Cachés de herramientas
*.tsbuildinfo

# Sesiones grabadas del portal de la DIAN (cookies y tokens): nunca se versionan
tools/dian/sesion/
