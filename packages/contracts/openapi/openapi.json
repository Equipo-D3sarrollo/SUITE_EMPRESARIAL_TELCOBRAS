{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Todas las dependencias responden",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "postgres": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "valkey": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "s3": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      },
                      "required": [
                        "postgres",
                        "valkey",
                        "s3"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Alguna dependencia no responde",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "error"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "postgres": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "valkey": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "s3": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      },
                      "required": [
                        "postgres",
                        "valkey",
                        "s3"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Estado de PostgreSQL, Valkey y S3",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/invitations": {
      "post": {
        "operationId": "InvitationsController_create",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "email",
                    "roleId",
                    "expiresAt"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "roleId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Invitar un usuario a la organización activa",
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/v1/invitations/{token}/accept": {
      "post": {
        "operationId": "InvitationsController_accept",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "organizationId"
                  ],
                  "properties": {
                    "organizationId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Aceptar una invitación a una organización",
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/v1/me/organizations": {
      "get": {
        "operationId": "OrganizationsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "nit",
                          "isActive"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "nit": {
                            "type": "string"
                          },
                          "isActive": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Listar las organizaciones del usuario autenticado",
        "tags": [
          "organizations"
        ]
      }
    },
    "/api/v1/organizations": {
      "post": {
        "operationId": "OrganizationsController_create",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Organización creada"
          }
        },
        "summary": "Crear una organización y asignar al creador el rol de propietario",
        "tags": [
          "organizations"
        ]
      }
    },
    "/api/v1/me/active-organization": {
      "post": {
        "operationId": "OrganizationsController_setActive",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Organización activa actualizada"
          }
        },
        "summary": "Cambiar la organización activa de la sesión",
        "tags": [
          "organizations"
        ]
      }
    },
    "/api/v1/me/permissions": {
      "get": {
        "operationId": "OrganizationsController_permissions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "dashboard:view",
                          "commercial:view",
                          "leadgen:view",
                          "documents:view",
                          "integrations:view",
                          "automation:view",
                          "ai:view",
                          "analytics:view",
                          "administration:view",
                          "help:view",
                          "organization:read",
                          "organization:update",
                          "members:read",
                          "members:invite",
                          "members:update",
                          "members:remove",
                          "roles:read",
                          "roles:create",
                          "roles:update",
                          "roles:delete",
                          "audit:read"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Listar permisos de la organización activa",
        "tags": [
          "organizations"
        ]
      }
    }
  },
  "info": {
    "title": "OrveX.IA API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
