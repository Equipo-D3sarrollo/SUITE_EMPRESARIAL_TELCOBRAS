# OrveX.IA: variables de entorno.
# Copia este archivo a .env (cp .env.example .env). Los valores son SOLO para desarrollo local
# y coinciden con infra/compose/docker-compose.yml. En cualquier otro ambiente se generan valores propios.

# --- API ---
NODE_ENV=development
API_PORT=3000
# Origen de la SPA: CORS y orígenes de confianza de Better Auth.
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- PostgreSQL 18 ---
# Puerto del host donde Compose publica PostgreSQL. Si 5432 está ocupado (p. ej. por un PostgreSQL
# de Windows), usa 5433 y cambia también el puerto de DATABASE_URL, DATABASE_OWNER_URL y DATABASE_WORKER_URL.
POSTGRES_PORT=5432
# Superusuario del contenedor: solo para administrar la base, nunca lo usa la API.
POSTGRES_PASSWORD=postgres_dev
# Contraseñas que infra/compose/postgres/init.sql asigna a los roles al crear la base.
APP_OWNER_PASSWORD=app_owner_dev
APP_USER_PASSWORD=app_user_dev
APP_WORKER_PASSWORD=app_worker_dev
# Runtime de la API: app_user (NOBYPASSRLS), sujeto a RLS.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5432/telcobras
# Migraciones y semillas: app_owner, dueño del esquema app.
DATABASE_OWNER_URL=postgres://app_owner:app_owner_dev@localhost:5432/telcobras
# Telco (DataDian): app_worker (NOBYPASSRLS), sujeto a RLS salvo la cola telco_jobs. Lo usan Telco y las
# pruebas de base de datos; la API no. En una base creada antes de este rol: infra/compose/postgres/app-worker.sql.
DATABASE_WORKER_URL=postgres://app_worker:app_worker_dev@localhost:5432/telcobras

# --- Valkey 9 (caché y almacenamiento secundario de Better Auth) ---
VALKEY_URL=redis://localhost:6379

# --- Almacenamiento S3 (SeaweedFS en local) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=telcobras-dev
S3_ACCESS_KEY_ID=telcobras_dev
S3_SECRET_ACCESS_KEY=telcobras_dev_secret
S3_FORCE_PATH_STYLE=true

# --- Correo (Mailpit en local; bandeja en http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OrveX.IA <no-reply@telcobras.local>"

# --- Better Auth ---
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-with-openssl-rand-base64-32
# URL pública que ve el navegador. En local, Vite reenvía /api a la API.
BETTER_AUTH_URL=http://localhost:5173
# Opcionales: sin ellos se oculta el acceso con Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cifrado envolvente de credenciales de clientes (ADR-009) ---
# 32 bytes en base64. Generar con: openssl rand -base64 32
CREDENTIALS_MASTER_KEY=ZGV2LW9ubHktY3JlZGVudGlhbHMta2V5LTMyLWJ5dGU=

# --- OpenTelemetry (opcional: sin endpoint no se activa) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=telcobras-api
