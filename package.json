{
  "name": "suite-empresarial-telcobras",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @telcobras/contracts build && pnpm -r --parallel --filter @telcobras/contracts --filter @telcobras/api --filter @telcobras/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @telcobras/web test:e2e",
    "check:palette": "node tools/check-palette.mjs",
    "check:bundle": "node tools/check-bundle-size.mjs",
    "knip": "knip",
    "db:migrate": "pnpm --filter @telcobras/api db:migrate",
    "db:seed": "pnpm --filter @telcobras/api db:seed",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down",
    "local": "node tools/local.mjs",
    "local:stop": "docker compose -f infra/compose/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "knip": "^6.44.1",
    "typescript": "catalog:"
  }
}
