{
  "name": "@telcobras/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --env-file ../../.env",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "node --conditions=@telcobras/source node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env --conditions=@telcobras/source src/database/seed.ts",
    "openapi:export": "tsx --env-file-if-exists=../../.env --conditions=@telcobras/source src/openapi-export.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@telcobras/contracts": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.12.0",
    "fastify": "^5.12.8",
    "fflate": "0.8.3",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "node-html-parser": "9.0.7",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.3",
    "@swc/core": "^1.16.21",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  }
}
