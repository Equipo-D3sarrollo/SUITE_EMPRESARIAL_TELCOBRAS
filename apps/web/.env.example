# Variables públicas de la SPA (Vite solo expone las que empiezan por VITE_). Copia este archivo a apps/web/.env.
# Vive aparte del .env de la raíz porque ese fija NODE_ENV=development para la API y Vite lo aplicaría al build.

# "true" solo si la API tiene GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET: muestra el acceso con Google Workspace.
VITE_AUTH_GOOGLE_ENABLED=false
